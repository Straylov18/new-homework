# Auto detect text files and perform LF normalization
* text=auto eol=lf
# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf
*.vuh text eol=lf
html-css-js-lessons/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
html-css-js-lessons/**/*.png filter=lfs diff=lfs merge=lfs -text
