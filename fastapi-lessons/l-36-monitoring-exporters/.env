# Api
BASE_ROUTE_PATH='/api/v1'

# Images and versions
CONTAINER_REGISTRY_PATH='cr.selcloud.ru/artifacts-registry'
IMAGE_PREFIX='submarine-reh-exporter'

API_IMAGE_NAME="$IMAGE_PREFIX-api"
API_IMAGE_VERSION=latest

WEB_IMAGE_NAME="$IMAGE_PREFIX-web"
WEB_IMAGE_VERSION=latest

GRAFANA_PASSWORD="strongest-pass"

# Postgres
POSTGRES_EXTERNAL_PORT=5435
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=master
POSTGRES_DB_ECHO=true
POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
POSTGRES_COMPUTE_QUERY_ID=auto
PG_STAT_STATEMENTS_TRACK=all
PG_STAT_STATEMENTS_MAX=10000
PG_STAT_STATEMENTS_SAVE=on
POSTGRES_EXPORTER_PORT=9188

# Grafana
GRAFANA_PASSWORD='pass?-no-pass'
