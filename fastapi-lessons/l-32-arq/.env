BASE_ROUTE_PATH='/api/v1'

# Redis (очередь и хранилище результатов для ARQ)
# При запуске через docker-compose REDIS_SERVER должен быть равен имени сервиса
REDIS_SERVER=redis
# REDIS_SERVER=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=default
REDIS_PASSWORD=master

# ARQ
# ARQ использует Redis напрямую: и как очередь задач, и как хранилище
# результатов. Настройки подключения строятся из параметров Redis выше.
# ARQ_QUEUE_NAME=arq:queue
# ARQ_JOB_RESULT_TTL=3600
# ARQ_MAX_JOBS=10

# Рассылка
EMAIL_LOG_FILE=data/mail.log
# Задержка "отправки" одного письма, сек
EMAIL_SEND_DELAY_SECONDS=1.0